# === System Files ===
.DS_Store
Thumbs.db
*.log

# === Local AI Runtime Caches ===
.claude/
.codex/
# Ignore .agents/ except the plugin marketplace manifest. Git cannot re-include a file
# inside an ignored directory, so each parent level is un-ignored explicitly.
.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json

# === Third-Party External Skills (Automated Wildcard) ===
# Automatically ignores any external skill prefixed with "ext-" 
skills/ext-*

# === IDEs and Text Editors ===
.vscode/
.idea/
*.swp
*.bak

# === Local Secrets / Environment Configurations ===
.env
.env.local
.env.*.local
*.pem
*.key
*.token
